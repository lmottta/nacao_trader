# Configurações do Motor de Sinais ML - Arquivo de exemplo
# Copie este arquivo para .env e ajuste os valores conforme necessário

# =================================================================
# CONFIGURAÇÕES SUPABASE
# =================================================================
# URL do seu projeto Supabase (obrigatório)
SUPABASE_URL=https://seu-projeto.supabase.co

# Chave anônima para acesso público (obrigatório)
SUPABASE_ANON_KEY=sua-chave-anonima-do-supabase

# Chave de serviço para acesso administrativo (obrigatório)
SUPABASE_SERVICE_KEY=sua-chave-de-servico-do-supabase

# URL de conexão direta com o PostgreSQL (opcional - configurado automaticamente)
# DATABASE_URL=postgresql://postgres:senha@postgres.seu-projeto.supabase.co:5432/postgres

# =================================================================
# CONFIGURAÇÕES DE API EXTERNA
# =================================================================
# API key para Finnhub (opcional)
FINNHUB_API_KEY=sua-chave-finnhub

# API key para Alpha Vantage (opcional)
ALPHA_VANTAGE_API_KEY=sua-chave-alpha-vantage

# API key para Twelve Data (opcional)
TWELVEDATA_API_KEY=sua-chave-twelvedata

# =================================================================
# CONFIGURAÇÕES DO SERVIDOR
# =================================================================
# Host para o servidor da API (padrão: 0.0.0.0)
HOST=0.0.0.0

# Porta para o servidor da API (padrão: 8000)
PORT=8000

# Modo de debug (padrão: false)
DEBUG=false

# Nível de log (padrão: INFO)
LOG_LEVEL=INFO

# =================================================================
# CONFIGURAÇÕES DO MOTOR ML
# =================================================================
# Intervalos de atualização (em segundos)
DATA_COLLECTION_INTERVAL=3600
ASSETS_REFRESH_INTERVAL=86400
ML_MODEL_UPDATE_INTERVAL=604800

# Limiares para modelos ML
ML_CONFIDENCE_THRESHOLD=0.65
SIGNAL_STRENGTH_THRESHOLD=0.75

# =================================================================
# CONFIGURAÇÕES DE CACHE E NOTIFICAÇÕES
# =================================================================
# Tempo de expiração do cache em segundos (padrão: 300)
CACHE_EXPIRY=300

# Ativar sistema de notificações (padrão: true)
ENABLE_NOTIFICATIONS=true

# URL do Redis para cache distribuído (opcional)
# REDIS_URL=redis://localhost:6379/0

# =================================================================
# CONFIGURAÇÕES DE ARMAZENAMENTO
# =================================================================
# Diretório para armazenamento de dados (padrão: ./data)
DATA_DIR=./data

# Diretório para armazenamento de modelos (padrão: ./models)
MODEL_DIR=./models

# =================================================================
# CONFIGURAÇÕES DE API PRÓPRIA
# =================================================================
# Chave de API para acesso à API do Motor (defina uma chave secreta)
API_KEY=chave-api-secreta-altere-para-uma-chave-forte 