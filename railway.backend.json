{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd motor && pip install -r requirements.txt"
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "cd motor && python -m src.api.main",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  },
  "variables": {
    "PYTHON_VERSION": "3.11",
    "PORT": "8000",
    "SUPABASE_URL": "ref:SUPABASE_URL",
    "SUPABASE_SERVICE_ROLE_KEY": "ref:SUPABASE_SERVICE_ROLE_KEY",
    "FINNHUB_API_KEY": "ref:FINNHUB_API_KEY",
    "ALPHA_VANTAGE_API_KEY": "ref:ALPHA_VANTAGE_API_KEY",
    "ENVIRONMENT": "production"
  }
}